  "info": {
    "_postman_id": "ce14001a-318d-4c62-b5af-3db1eb785dc3",
    "name": "Azure Durable Functions HTTP Entities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Azure Durable Functions extension exposes built-in HTTP APIs for managing orchestrations, entities, and task hubs. These HTTP APIs are extensibility webhooks authorized by the Azure Functions host and handled by the Durable Functions extension. Use them to start orchestrations, query status, raise events, terminate, suspend, resume, rewind, signal entities, and purge history.\n\nContact Support:\n Name: Microsoft Azure",
      "type": "text/plain"
    }
  }
